# PLANTILLA DOCUMENTAL: Spring/PowerShell no cargan este archivo automáticamente.
# Usa las instrucciones del README para definir variables del proceso.
# No introducir secretos aquí ni copiar una .env con credenciales al repositorio.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tienda_usuarios
SPRING_DATASOURCE_USERNAME=<USUARIO_POSTGRESQL_LOCAL>
SPRING_DATASOURCE_PASSWORD=<INTRODUCIR_POR_PROMPT_OCULTO>
JWT_SECRET=<BASE64_DE_32_BYTES_ALEATORIOS_O_GENERACION_LOCAL_DEL_SCRIPT>
# Opcional, solo para herramientas de diseño; no requerido por la aplicación:
STITCH_API_KEY=<CLAVE_PERSONAL_SOLO_EN_EL_ENTORNO>
